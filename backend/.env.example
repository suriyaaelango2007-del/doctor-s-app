# Direct Postgres connection string.
# Supabase Dashboard -> Connect -> "Session pooler" (IPv4) or "Direct connection".
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Dashboard -> Project Settings -> API / JWT Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# Milestone 5 — ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Milestone 6 — Claude API key for summaries
LLM_API_KEY=

# Email. Leave EMAIL_API_KEY empty to print emails to the console instead.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Clinic <onboarding@resend.dev>

FRONTEND_URL=http://localhost:3000
MAX_CONCURRENT_CALLS=3
TZ=Asia/Kolkata

# Dev only: shift the app clock (minutes) to test the 18:00 / 19:00 rules.
ENVIRONMENT=development
TIME_OFFSET_MINUTES=0
