# Direct Postgres connection string.
# Supabase Dashboard -> Connect -> "Session pooler" (IPv4) or "Direct connection".
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Dashboard -> Project Settings -> API / JWT Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if your project still uses the legacy HS256 JWT secret
SUPABASE_JWT_SECRET=

# Milestone 5 — ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Twilio (telephony behind ElevenLabs). Prototype: trial account, verified numbers only.
TWILIO_ACCOUNT_SID=               # only needed if the backend looks up call status in Twilio
TWILIO_AUTH_TOKEN=
TWILIO_TRIAL_MODE=true
VERIFIED_TEST_NUMBERS=+919876543210,+919812345678

# Milestone 6 — Claude API key for summaries (console.anthropic.com)
LLM_API_KEY=
# claude-haiku-4-5 (cheapest) | claude-sonnet-5 | claude-opus-5 (adds automatic refusal fallback)
LLM_MODEL=claude-haiku-4-5

# Email: resend (EMAIL_API_KEY) or smtp (SMTP_*). No credentials = emails print to the console.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Clinic <onboarding@resend.dev>
# Or send through Gmail (no domain needed): EMAIL_PROVIDER=smtp, your Gmail address, and an
# App Password (Google Account -> Security -> 2-Step Verification on -> App passwords). ~500 emails/day.
# EMAIL_FROM should then be "Your Clinic <you@gmail.com>".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

FRONTEND_URL=http://localhost:3000
MAX_CONCURRENT_CALLS=3
TZ=Asia/Kolkata

# Dev only: shift the app clock (minutes) to test the 18:00 / 19:00 rules.
ENVIRONMENT=development
TIME_OFFSET_MINUTES=0
